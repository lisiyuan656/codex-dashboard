[Unit]
Description=Codex Dashboard Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/codex-dashboard-agent/agent.env
ExecStart=/usr/bin/env codex-dashboard-agent
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
