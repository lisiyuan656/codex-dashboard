CODEX_DASHBOARD_SERVER_PORT=8000
CODEX_DASHBOARD_DATA_DIR=./docker/data
CODEX_DASHBOARD_DATABASE_URL=sqlite:////var/lib/codex-dashboard/codex_dashboard.db
